library(car)
library(caret)
library(tidyverse)
library(leaps)
library(dplyr)
library(ggpubr)
library(rsample)
library(pROC)
# Recopilación de datos
datos <- read.csv2("EP09 Datos.csv")
calculate_IMC <- function(roww){
peso <- roww["Weight"]
altura <- roww["Height"]/100
IMC <- peso / (altura**2)
return(IMC)
}
imc_array <- apply(datos,1,calculate_IMC)
new_dataframe <- cbind(datos,imc_array)
umbral <- 23.2
# 1 ->  tiene sobrepeso, 2 -> no sobrepeso
estado_nutricional <- function(row){
if(row["imc_array"] >= umbral){
return(1)
}else if(row["imc_array"] < umbral){
return(0)
}else{
return(0)
}
}
EN <- apply(new_dataframe,1,estado_nutricional)
datos_IMC <- cbind(new_dataframe,EN)
set.seed(3234)
# Nuestro número de equipo es par, por lo tanto debemos elegir una muestra de 150 mujeres.
mujeres_inicial <- datos[which(datos$Gender == 0),]
mujeres <- datos_IMC[which(datos_IMC$Gender == 0),]
cut <- 150/2
mujeres_sobrepeso <- datos_IMC[which(datos_IMC$EN == 1),]
mujeres_no_sobrepeso <- datos_IMC[which(datos_IMC$EN == 0),]
mujeres_sobrepeso <- mujeres_sobrepeso |>
sample_n(cut)
mujeres_no_sobrepeso <- mujeres_no_sobrepeso |>
sample_n(cut)
muestra <- bind_rows(mujeres_sobrepeso,mujeres_no_sobrepeso) |> slice_sample(prop = 1)
muestra_100 <- bind_rows(muestra[which(muestra$EN == 0),] |> sample_n(50), muestra[which(muestra$EN == 1),] |> sample_n(50))|> slice_sample(prop = 1)
muestra_50 <- muestra |>
anti_join(muestra_100)
set.seed(3234)
# EXACT SAME RANDOM STEPS
mujeres_random <- mujeres_inicial |> sample_n(100)
mujeres_random70 <- mujeres_random |> sample_n(70)
mujeres_filtrado <- mujeres_random |>
select(-Height,-Weight,-Gender)
columnas_raw <- names(mujeres_filtrado)
columnas <- data.frame(columnas_raw)
variables_aleatorias <- columnas |> sample_n(8)
names_raw <- variables_aleatorias$columnas_raw
print(names_raw)
seleccion_dataframe <- muestra_100 |>
select(EN, Hip.Girth, all_of(names_raw))
#imc_array <- datos_IMC$imc_array
#seleccion_dataframe <- cbind(seleccion_dataframe,Hip.Girth,EN)
library("DT")
Descripcion  = c("Grosor del pecho, sobre tejido mamario en mujeres y a la altura de los pezones en varones","Grosor promedio de la parte más delgada de ambos tobillos", "Grosor promedio de la parte más delgada de ambas muñecas", "Edad", "Grosor de los hombros sobre los músculos deltoides", "Grosor promedio de ambos muslos bajo el pliegue del glúteo", "Grosor promedio de la parte más ancha de ambas pantorrillas", "Grosor a la altura de la cintura") #Descripción de cada componente
Unidad = c("cm", "cm", "cm", "Años", "cm", "cm", "cm", "cm")
#Tipos de variables correspondientes a los componentes
#Tabla recopilando los datos anteriores
Tabla_variables = data.frame(names_raw,Descripcion,Unidad)
datatable(Tabla_variables,
options = list(pageLength = 14),
caption = "Tabla de descripción de variables aleatorias")
nulo <- glm(EN ~ 1, family= binomial(link = "logit"), data = seleccion_dataframe)
completo <- glm(EN ~ ., family = binomial(link = "logit"), data = seleccion_dataframe)
modelo <- glm(EN ~ Hip.Girth, family = binomial(link = "logit"), data = seleccion_dataframe)
print(summary(modelo), signif.stars = FALSE)
cat("----\n")
print(anova(modelo, test = "LRT"), signif.stars = FALSE)
modelo_actual <- glm(
EN ~ Hip.Girth,
data = seleccion_dataframe,
family = binomial
)
AIC(modelo_actual)
candidatas <- setdiff(names_raw, "Hip.Girth")
resultados <- lapply(candidatas, function(var) {
f <- reformulate(c("Hip.Girth", var), response = "EN")
m <- glm(f, data = seleccion_dataframe, family = binomial)
c(variable = var, AIC = AIC(m))
})
tabla_AIC <- do.call(rbind, resultados)
tabla_AIC <- as.data.frame(tabla_AIC)
tabla_AIC$AIC <- as.numeric(tabla_AIC$AIC)
tabla_AIC[order(tabla_AIC$AIC), ]
modelo <- update(
modelo_actual,
. ~ . + Waist.Girth
)
print(summary(modelo), signif.stars = FALSE)
cat("----\n")
print(anova(modelo, test = "LRT"), signif.stars = FALSE)
