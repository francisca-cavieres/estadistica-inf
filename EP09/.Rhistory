View(variables_aleatorias)
modelo_HG <- update(peso_nulo, . ~ . + Hip.Girth)
summary(modelo_HG)
g1 <- ggscatter ( datos , x = " disp " , y = " hp " ,
color = " steelblue " , fill = " steelblue1 " , alpha = 0.5 , size = 3 ,
ylab = " Potencia [ hp ] " )
library ( ggpubr )
g1 <- ggscatter ( datos , x = " disp " , y = " hp " ,
color = " steelblue " , fill = " steelblue1 " , alpha = 0.5 , size = 3 ,
ylab = " Potencia [ hp ] " )
g1 <- g1 + geom_abline ( intercept = coef (modelo_HG)[1] , slope = coef(modelo_HG)[2], color = " steelblue4 " )
g1 <- g1 + xlab ( bquote ( " Volumen ú til de los cilindros " ~ group ( " [ " , " in " ^3 , " ] " ) ) )
