library(dplyr)
library(rsample)
datos <- read.csv2("EP09 Datos.csv")
# 21823234-5
set.seed(3234)
mujeres <- datos |>
filter(datos$Gender == 0)
# Como la semilla es un número par
mujeres_random <- mujeres |>
sample_n(100)
mujeres_filtrado <- mujeres_random |>
select(-Height,-Weight,-Gender)
columnas_raw <- names(mujeres_filtrado)
columnas <- data.frame(columnas_raw)
variables_aleatorias <- columnas |>
sample_n(8)
names_raw <- variables_aleatorias$columnas_raw
mujeres_filtrado2 <- mujeres_filtrado |>
select(all_of(names_raw))
mujeres_filtrado_con_peso <- mujeres_random |>
select(-Height,-Gender)
mujeres_seleccion <- mujeres_filtrado_con_peso |>
select(-all_of(names_raw))
# Generamos un modelo nulo del peso para poder agregar variables
peso_nulo <- lm(Weight ~ 1, mujeres_seleccion)
completo <- lm(Weight ~ ., mujeres_seleccion)
summary(peso_nulo)
paso <- add1(peso_nulo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
paso <- add1(peso_nulo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
paso <- add1(peso_nulo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
summary(modelo)
modelo <- update(peso_nulo, . ~ . + Hip.Girth)
summary(modelo)
paso <- add1(modelo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
cat("", paste("Modelo:", format(formula(modelo))), format(paso), sep = "\n")
paso <- add1(modelo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
paso <- add1(peso_nulo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
cat("", paste("Modelo:", format(formula(peso_nulo))), format(paso, sep = "\n"))
library(tidyr)
paso <- add1(peso_nulo, scope = completo, test = "F") |> tidy() |> mutate(p.value = format(pvalue(p.value), justify = "right")) |> arrange(AIC)
library(dplyr)
library(rsample)
datos <- read.csv2("EP09 Datos.csv")
# 21823234-5
set.seed(3234)
mujeres <- datos |>
filter(datos$Gender == 0)
# Como la semilla es un número par
mujeres_random <- mujeres |>
sample_n(100)
mujeres_filtrado <- mujeres_random |>
select(-Height,-Weight,-Gender)
columnas_raw <- names(mujeres_filtrado)
columnas <- data.frame(columnas_raw)
variables_aleatorias <- columnas |>
sample_n(8)
names_raw <- variables_aleatorias$columnas_raw
mujeres_filtrado_con_peso <- mujeres_random |>
select(-Height,-Gender)
mujeres_seleccion <- mujeres_filtrado_con_peso |>
select(-all_of(names_raw))
# Generamos un modelo nulo del peso para poder agregar variables
peso_nulo <- lm(Weight ~ 1, mujeres_seleccion)
completo <- lm(Weight ~ ., mujeres_seleccion)
summary(peso_nulo)
paso <- add1(
peso_nulo,
scope = completo,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
paso
modelo <- update(peso_nulo, . ~ . + Hip.Girth)
summary(modelo)
mujeres_filtrado2 <- mujeres_filtrado_con_peso |>
select(all_of(names_raw),Weight,Hip.Girth)
completo_variables_aleatorias <- lm(Weight ~ Hip.Girth + ., mujeres_filtrado2)
summary(completo_variables_aleatorias)
paso <- add1(
modelo,
scope = completo_variables_aleatorias,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
paso <- add1(
modelo,
scope = completo_variables_aleatorias,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
paso <- add1(
modelo,
scope = completo_variables_aleatorias,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
paso <- add1(
peso_nulo,
scope = completo,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
paso <- add1(
modelo,
scope = completo_variables_aleatorias,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
modelo <- update(peso_nulo, . ~ . + Hip.Girth + Knee.Girth)
paso <- add1(
modelo,
scope = completo_variables_aleatorias,
test = "F"
) |>
as.data.frame() |>
tibble::rownames_to_column("variable") |>
arrange(AIC)
